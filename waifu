#!/usr/bin/env bash
# waifu - Fetch and display random anime waifu images in kitty terminal
# Uses: nekosapi.com v4, waifu.im, nekos.best APIs
# See waifu nsfw --help for NSFW options
#
# Repository: https://github.com/JGH0/waifufetch
# License: MIT

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/libwaifu.sh"

main() {
    # ============================================================
    # Parse flags from anywhere
    # ============================================================
    DEBUG=0
    NO_LINK=0
    RESET_SETTINGS=0
    IMAGE_INPUT_FILE=""
    local FILTERED_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)        DEBUG=1; shift ;;
            --noLink)       NO_LINK=1; shift ;;
            --resetSettings)
                rm -rf "$WAIFU_CONFIG_DIR"
                echo "Settings reset. Config directory removed: $WAIFU_CONFIG_DIR"
                exit 0
                ;;
            -v|--version)
                echo "waifu v$VERSION"
                exit 0
                ;;
            -i)
                if [[ $# -lt 2 ]]; then
                    echo "Error: -i requires a file path argument" >&2
                    exit 1
                fi
                IMAGE_INPUT_FILE="$2"
                shift 2
                ;;
            *)         FILTERED_ARGS+=("$1"); shift ;;
        esac
    done
    set -- "${FILTERED_ARGS[@]}"

    # ============================================================
    # Help (scan all args for --help)
    # ============================================================
    local HELP_REQUESTED=0 HELP_NSFW=0
    for arg in "$@"; do
        if [[ "$arg" == "--help" ]]; then
            HELP_REQUESTED=1
        fi
    done
    if [[ $HELP_REQUESTED -eq 1 ]]; then
        for arg in "$@"; do
            if [[ "$arg" == "nsfw" ]]; then
                HELP_NSFW=1
                break
            fi
        done
        if [[ $HELP_NSFW -eq 1 ]]; then
            nsfw_help "waifu"
        fi
        usage "waifu"
    fi

    # ============================================================
    # Set default displayer
    # ============================================================
    if [[ "${1:-}" == "--setDefaultDisplayer" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Usage: waifu --setDefaultDisplayer <displayer>"
            echo "Valid: icat, chafa, img2txt, jp2a"
            echo "Run with empty value to clear: --setDefaultDisplayer \"\""
            exit 1
        fi
        local NEW_DISP="$2"
        case "$NEW_DISP" in
            icat|chafa|img2txt|jp2a)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "$NEW_DISP" > "$WAIFU_DISPLAYER_FILE"
                echo "Default displayer set to: $NEW_DISP"
                ;;
            "")
                rm -f "$WAIFU_DISPLAYER_FILE"
                echo "Default displayer cleared (will auto-detect)"
                ;;
            *)
                echo "Error: Invalid displayer '$NEW_DISP'. Valid: icat, chafa, img2txt, jp2a" >&2
                exit 1
                ;;
        esac
        exit 0
    fi

    # ============================================================
    # Set default SFW
    # ============================================================
    if [[ "${1:-}" == "--setDefaultSFW" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Usage: waifu --setDefaultSFW <rating>"
            echo "Valid: safe, suggestive, borderline"
            echo "Run with empty value to reset to default: --setDefaultSFW \"\""
            exit 1
        fi
        local NEW_VAL="$2"
        case "$NEW_VAL" in
            safe)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "safe" > "$CONFIG_FILE"
                echo "Default SFW rating set to: safe (safe only)"
                ;;
            suggestive)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "suggestive" > "$CONFIG_FILE"
                echo "Default SFW rating set to: suggestive (safe + suggestive)"
                ;;
            borderline)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "borderline" > "$CONFIG_FILE"
                echo "Default SFW rating set to: borderline (safe + suggestive + borderline)"
                ;;
            explicit)
                echo "Error: Cannot set default SFW to 'explicit'. Use 'waifu explicit' for one-off requests." >&2
                exit 1
                ;;
            "")
                rm -f "$CONFIG_FILE"
                echo "Default SFW rating reset to: safe (default)"
                ;;
            *)
                echo "Error: Invalid rating '$NEW_VAL'. Valid: safe, suggestive, borderline" >&2
                exit 1
                ;;
        esac
        exit 0
    fi

    # ============================================================
    # Parse positional displayer from first arg
    # ============================================================
    DISPLAYER="$DEFAULT_DISPLAYER"
    if [[ $# -ge 1 ]]; then
        case "${1}" in
            icat|chafa|img2txt|jp2a)
                DISPLAYER="${1}"
                shift
                ;;
        esac
    fi

    # ============================================================
    # Parse mode/category/rating
    # ============================================================
    MODE="sfw"
    RATING_LEVEL="$DEFAULT_SFW"
    CATEGORY="waifu"
    IS_DIRECT_RATING=0

    if [[ $# -ge 1 ]]; then
        case "${1}" in
            sfw)
                MODE="sfw"
                RATING_LEVEL="$DEFAULT_SFW"
                [[ $# -ge 2 ]] && CATEGORY="$2"
                ;;
            nsfw)
                MODE="nsfw"
                RATING_LEVEL="explicit"
                [[ $# -ge 2 ]] && CATEGORY="$2"
                ;;
            safe|suggestive|borderline|explicit)
                RATING_LEVEL="${1}"
                IS_DIRECT_RATING=1
                if [[ "${1}" == "explicit" ]]; then
                    MODE="nsfw"
                else
                    MODE="sfw"
                fi
                [[ $# -ge 2 ]] && CATEGORY="$2"
                ;;
            *)
                CATEGORY="${1}"
                ;;
        esac
    fi

    # ============================================================
    # Unknown tag warning
    # ============================================================
    local TAG_UNKNOWN=1
    for t in "${ALL_KNOWN_TAGS[@]}"; do
        if [[ "$t" == "$CATEGORY" ]]; then
            TAG_UNKNOWN=0
            break
        fi
    done
    if [[ $TAG_UNKNOWN -eq 1 ]]; then
        for r in "${ALL_RATINGS[@]}"; do
            if [[ "$r" == "$CATEGORY" ]]; then
                TAG_UNKNOWN=0
                break
            fi
        done
    fi
    if [[ $TAG_UNKNOWN -eq 1 ]]; then
        echo "Warning: '$CATEGORY' not in known categories. See 'waifu --help' for available options." >&2
    fi

    # ============================================================
    # Build API rating param
    # ============================================================
    build_api_rating

    # ============================================================
    # Debug output
    # ============================================================
    if [[ $DEBUG -eq 1 ]]; then
        echo "[debug] mode:         $MODE" >&2
        echo "[debug] rating_level: $RATING_LEVEL" >&2
        echo "[debug] is_direct:    $IS_DIRECT_RATING" >&2
        echo "[debug] api_rating:   $API_RATING" >&2
        echo "[debug] category:     $CATEGORY" >&2
        echo "[debug] default_sfw:  $DEFAULT_SFW" >&2
        echo "[debug] displayer:    ${DISPLAYER:-auto}" >&2
    fi

    # ============================================================
    # Handle -i (local file) mode
    # ============================================================
    IMAGE_URL=""
    IMAGE_FILE=""
    FROM_CACHE=0
    if [[ -n "$IMAGE_INPUT_FILE" ]]; then
        if [[ ! -f "$IMAGE_INPUT_FILE" ]]; then
            echo "Error: File not found: $IMAGE_INPUT_FILE" >&2
            exit 1
        fi
        IMAGE_FILE="$(_mktemp)" && cp "$IMAGE_INPUT_FILE" "$IMAGE_FILE"
        IMAGE_URL="file://$IMAGE_INPUT_FILE"
        FROM_CACHE=0
    fi

    # ============================================================
    # Cache + fetch (skip for local file mode)
    # ============================================================
    if [[ -z "$IMAGE_INPUT_FILE" ]]; then
        fetch_and_cache

        if [[ -z "$IMAGE_URL" ]]; then
            local FOUND=0
            for t in "${ALL_KNOWN_TAGS[@]}"; do
                if [[ "$t" == "$CATEGORY" ]]; then
                    FOUND=1
                    break
                fi
            done
            if [[ $FOUND -eq 0 ]]; then
                echo "Error: '$CATEGORY' not found in known categories." >&2
                echo "Run 'waifu --help' to see available categories and ratings." >&2
            else
                echo "Error: No images found for '$CATEGORY' with rating '$API_RATING'." >&2
                echo "All sources failed. Try a different tag." >&2
                echo "Run 'waifu --help' for help." >&2
            fi
            exit 1
        fi
    fi

    # ============================================================
    # Display
    # ============================================================
    if is_gif_file "$IMAGE_FILE" 2>/dev/null; then
        if [[ "$DISPLAYER" == "jp2a" || "$DISPLAYER" == "img2txt" ]]; then
            echo "Warning: '$DISPLAYER' does not support GIF animation. Showing static frame only." >&2
            # Extract first frame as PNG for displayer compatibility
            local static_file
            static_file="$(_mktemp).png"
            if command -v convert &>/dev/null; then
                convert "$IMAGE_FILE[0]" "$static_file" 2>/dev/null && IMAGE_FILE="$static_file"
            elif command -v ffmpeg &>/dev/null; then
                ffmpeg -y -i "$IMAGE_FILE" -vframes 1 "$static_file" 2>/dev/null && IMAGE_FILE="$static_file"
            fi
        fi
    fi

    display_image "$IMAGE_FILE" "$IMAGE_URL" "$DISPLAYER" || echo "Image display failed (try a different displayer)." >&2

    if [[ $DEBUG -eq 1 ]]; then
        echo "[debug] url:   $IMAGE_URL" >&2
        echo "[debug] cache: $FROM_CACHE" >&2
        echo "[debug] ---" >&2
    fi
    if [[ $NO_LINK -eq 0 ]]; then
        echo "$IMAGE_URL"
    fi

    prefetch_cache
}

main "$@" || true

