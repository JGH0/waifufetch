#!/usr/bin/env bash
# waifu - Fetch and display random anime waifu images in kitty terminal
# Uses: nekosapi.com v4, nekos.best, danbooru APIs
# See waifu nsfw --help for NSFW options
#
# Repository: https://github.com/JGH0/waifufetch
# License: MIT

set -euo pipefail 2>/dev/null || set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/libwaifu.sh"

main() {
    # ============================================================
    # Parse flags (shared with the `waifufetch` command)
    # ============================================================
    parse_common_flags "waifu" 0 "$@"

    # ============================================================
    # Help + --setDefault* handling (shared)
    # ============================================================
    set -- ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}
    handle_help_and_setdefaults "waifu" "$@"

    # ============================================================
    # Mode / rating / category parsing (shared)
    # ============================================================
    parse_mode_and_category "waifu" "$@"


    # ============================================================
    # Build API rating param
    # ============================================================
    build_api_rating

    # ============================================================
    # Debug output
    # ============================================================
    if [[ $DEBUG -eq 1 ]]; then
        echo "[debug] mode:         $MODE" >&2
        echo "[debug] rating_level: $RATING_LEVEL" >&2
        echo "[debug] is_direct:    $IS_DIRECT_RATING" >&2
        echo "[debug] api_rating:   $API_RATING" >&2
        echo "[debug] category:     $CATEGORY" >&2
        echo "[debug] default_sfw:  $DEFAULT_SFW" >&2
        echo "[debug] displayer:    ${DISPLAYER:-auto}" >&2
    fi

    # ============================================================
    # Handle -i (local file) mode
    # ============================================================
    IMAGE_URL=""
    IMAGE_FILE=""
    FROM_CACHE=0
    if [[ -n "$IMAGE_INPUT_FILE" ]]; then
        if [[ ! -f "$IMAGE_INPUT_FILE" ]]; then
            echo "Error: File not found: $IMAGE_INPUT_FILE" >&2
            exit 1
        fi
        IMAGE_FILE="$(_mktemp)" && cp "$IMAGE_INPUT_FILE" "$IMAGE_FILE"
        IMAGE_URL="file://$IMAGE_INPUT_FILE"
        FROM_CACHE=0
    fi

    # ============================================================
    # Cache + fetch (skip for local file mode)
    # ============================================================
    if [[ -z "$IMAGE_INPUT_FILE" ]]; then
        if ! command -v curl &>/dev/null; then
            echo "Error: 'curl' not found. Install curl or use 'waifu -i <file>' for local images." >&2
            exit 1
        fi
        if ! curl --version &>/dev/null; then
            echo "Error: curl is installed but broken (library link error?)." >&2
            echo "Try: pkg upgrade curl libngtcp2     (Termux)" >&2
            echo "  or: pacman -S curl                 (Arch)" >&2
            echo "  or: apt install --reinstall curl   (Debian)" >&2
            # Invalidate cache to prevent corrupted image display
            rm -f /tmp/waifu/meta.txt /tmp/waifu/img 2>/dev/null || true
            exit 1
        fi
        fetch_and_cache

        if [[ -z "$IMAGE_URL" ]]; then
            local FOUND=0
            for t in "${ALL_KNOWN_TAGS[@]}"; do
                if [[ "$t" == "$CATEGORY" ]]; then
                    FOUND=1
                    break
                fi
            done
            if [[ $FOUND -eq 0 ]]; then
                echo "Error: '$CATEGORY' not found in known categories." >&2
                echo "Run 'waifu --help' to see available categories and ratings." >&2
            else
                echo "Error: No images found for '$CATEGORY' with rating '$API_RATING'." >&2
                echo "All sources failed. Try a different tag." >&2
                echo "Run 'waifu --help' for help." >&2
            fi
            exit 1
        fi
    fi

    # ============================================================
    # Display
    # ============================================================
    if is_gif_file "$IMAGE_FILE" 2>/dev/null; then
        if [[ "$DISPLAYER" == "jp2a" || "$DISPLAYER" == "img2txt" ]]; then
            echo "Warning: '$DISPLAYER' does not support GIF animation. Showing static frame only." >&2
            # Extract first frame as PNG for displayer compatibility
            local static_file
            static_file="$(_mktemp).png"
            if command -v convert &>/dev/null; then
                convert "$IMAGE_FILE[0]" "$static_file" 2>/dev/null && IMAGE_FILE="$static_file"
            elif command -v ffmpeg &>/dev/null; then
                ffmpeg -y -i "$IMAGE_FILE" -vframes 1 "$static_file" 2>/dev/null && IMAGE_FILE="$static_file"
            fi
        fi
    fi

    display_image "$IMAGE_FILE" "$IMAGE_URL" "$DISPLAYER" || echo "Image display failed (try a different displayer)." >&2

    if [[ $DEBUG -eq 1 ]]; then
        echo "[debug] url:   $IMAGE_URL" >&2
        echo "[debug] cache: $FROM_CACHE" >&2
        echo "[debug] ---" >&2
    fi
    if [[ $NO_LINK -eq 0 ]]; then
        echo "$IMAGE_URL"
    fi

    prefetch_cache
}

main "$@" || true

