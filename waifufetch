#!/usr/bin/env bash
# waifufetch - system info with a random waifu decoration
# Like fastfetch/neofetch, but with waifu images instead of ASCII logos
#
# Repository: https://github.com/JGH0/waifufetch
# License: MIT

set -euo pipefail 2>/dev/null || set -eu
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/libwaifu.sh"

main() {
    # ============================================================
    # Parse flags from anywhere (must be first)
    # ============================================================
    DEBUG=0
    NO_LINK=0
    RESET_SETTINGS=0
    IMAGE_INPUT_FILE=""
    local FILTERED_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --debug)                      DEBUG=1; shift ;;
            --noLink)                     NO_LINK=1; shift ;;
            --config|-c)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --config/-c requires a file path argument" >&2
                    exit 1
                fi
                CONFIG_PATH="$2"
                shift 2
                ;;
            --list-tags|--list-categories|--list-ratings)
                local _list_mode="${1#--list-}"
                local _list_api=""
                shift
                # Check if nsfw was given before --list-tags (stored in FILTERED_ARGS)
                for _pre_arg in "${FILTERED_ARGS[@]}"; do
                    [[ "$_pre_arg" == "nsfw" ]] && { _list_mode="nsfw"; break; }
                done
                # Default --list-tags shows SFW-only tags
                [[ "$_list_mode" == "tags" ]] && _list_mode="sfw"
                # Accept: --list-tags <src>, --list-tags -a <src>
                if [[ $# -ge 1 ]]; then
                    if [[ "$1" == "-a" || "$1" == "--api" ]]; then
                        shift; [[ $# -ge 1 ]] && { _list_api="$1"; shift; }
                    else
                        for _s in "${KNOWN_API_SOURCES[@]}"; do
                            [[ "$1" == "$_s" && "$_s" != "auto" ]] && { _list_api="$1"; shift; break; }
                        done
                    fi
                fi
                print_tag_lists "$_list_mode" "$_list_api"
                exit 0
                ;;
            --help-config)
                print_config_help
                exit 0
                ;;
            --print-default-config)
                echo "$WAIFU_DEFAULT_CONFIG_JSON"
                exit 0
                ;;
            --resetSettings)
                rm -rf "$WAIFU_CONFIG_DIR"
                echo "Settings reset. Config directory removed: $WAIFU_CONFIG_DIR"
                exit 0
                ;;
            -v|--version)
                echo "waifufetch v$VERSION"
                exit 0
                ;;
            -i)
                if [[ $# -lt 2 ]]; then
                    echo "Error: -i requires a file path argument" >&2
                    exit 1
                fi
                IMAGE_INPUT_FILE="$2"
                shift 2
                ;;
            -a|--api)
                if [[ $# -lt 2 ]]; then
                    echo "Error: -a/--api requires an API source argument" >&2
                    echo "Valid: auto, waifu.im, nekosapi, nekos.best, danbooru" >&2
                    exit 1
                fi
                local _api_valid=0
                for _s in "${KNOWN_API_SOURCES[@]}"; do
                    [[ "$2" == "$_s" ]] && { _api_valid=1; break; }
                done
                if [[ $_api_valid -eq 0 ]]; then
                    echo "Error: Unknown API source '$2'. Valid: auto, waifu.im, nekosapi, nekos.best, danbooru" >&2
                    exit 1
                fi
                API_SOURCE="$2"
                shift 2
                ;;
            *)         FILTERED_ARGS+=("$1"); shift ;;
        esac
    done

    # Load JSON config
    load_json_config "${CONFIG_PATH:-$WAIFU_JSON_CONFIG}" || true

    # Must guard empty array expansion for bash < 4.0 (macOS) with set -u
    if [[ ${#FILTERED_ARGS[@]} -eq 0 ]]; then
        set --
    else
        set -- "${FILTERED_ARGS[@]}"
    fi

    # ============================================================
    # Help (scan all args)
    # ============================================================
    local HELP_REQUESTED=0
    for arg in "$@"; do
        if [[ "$arg" == "--help" ]]; then
            HELP_REQUESTED=1
        fi
    done
    if [[ $HELP_REQUESTED -eq 1 ]]; then
        for arg in "$@"; do
            if [[ "$arg" == "nsfw" ]]; then
                nsfw_help "waifufetch"
            fi
        done
        usage "waifufetch"
    fi

    # ============================================================
    # Set default displayer
    # ============================================================
    if [[ "${1:-}" == "--setDefaultDisplayer" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Usage: waifufetch --setDefaultDisplayer <displayer>"
            echo "Valid: icat, chafa, img2txt, jp2a"
            echo "Run with empty value to clear: --setDefaultDisplayer \"\""
            exit 1
        fi
        local NEW_DISP="$2"
        case "$NEW_DISP" in
            icat|chafa|img2txt|jp2a)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "$NEW_DISP" > "$WAIFU_DISPLAYER_FILE"
                echo "Default displayer set to: $NEW_DISP"
                ;;
            "")
                rm -f "$WAIFU_DISPLAYER_FILE"
                echo "Default displayer cleared (will auto-detect)"
                ;;
            *)
                echo "Error: Invalid displayer '$NEW_DISP'. Valid: icat, chafa, img2txt, jp2a" >&2
                exit 1
                ;;
        esac
        exit 0
    fi

    # ============================================================
    # Set default SFW
    # ============================================================
    if [[ "${1:-}" == "--setDefaultSFW" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Usage: waifufetch --setDefaultSFW <rating>"
            echo "Valid: safe, suggestive, borderline"
            echo "Run with empty value to reset to default: --setDefaultSFW \"\""
            exit 1
        fi
        local NEW_VAL="$2"
        case "$NEW_VAL" in
            safe)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "safe" > "$CONFIG_FILE"
                echo "Default SFW rating set to: safe (safe only)"
                ;;
            suggestive)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "suggestive" > "$CONFIG_FILE"
                echo "Default SFW rating set to: suggestive (safe + suggestive)"
                ;;
            borderline)
                mkdir -p "$WAIFU_CONFIG_DIR"
                echo "borderline" > "$CONFIG_FILE"
                echo "Default SFW rating set to: borderline (safe + suggestive + borderline)"
                ;;
            explicit)
                echo "Error: Cannot set default SFW to 'explicit'. Use 'waifufetch explicit' for one-off requests." >&2
                exit 1
                ;;
            "")
                rm -f "$CONFIG_FILE"
                echo "Default SFW rating reset to: safe (default)"
                ;;
            *)
                echo "Error: Invalid rating '$NEW_VAL'. Valid: safe, suggestive, borderline" >&2
                exit 1
                ;;
        esac
        exit 0
    fi

    # ============================================================
    # Set default API
    # ============================================================
    if [[ "${1:-}" == "--setDefaultAPI" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "Usage: waifufetch --setDefaultAPI <source>"
            echo "Valid: auto, waifu.im, nekosapi, nekos.best, danbooru"
            echo "Run with empty value to reset to default: --setDefaultAPI \"\""
            exit 1
        fi
        local NEW_API_VAL="$2"
        if [[ -z "$NEW_API_VAL" ]]; then
            rm -f "$WAIFU_API_FILE"
            echo "Default API source reset to: auto (fallback chain)"
            exit 0
        fi
        local _api_valid=0
        for _s in "${KNOWN_API_SOURCES[@]}"; do
            [[ "$NEW_API_VAL" == "$_s" ]] && { _api_valid=1; break; }
        done
        if [[ $_api_valid -eq 0 ]]; then
            echo "Error: Invalid API source '$NEW_API_VAL'. Valid: auto, waifu.im, nekosapi, nekos.best, danbooru" >&2
            exit 1
        fi
        mkdir -p "$WAIFU_CONFIG_DIR"
        printf '%s\n' "$NEW_API_VAL" > "$WAIFU_API_FILE"
        echo "Default API source set to: $NEW_API_VAL"
        echo "  auto       - fallback chain: nekosapi -> waifu.im -> nekos.best -> danbooru"
        echo "  waifu.im   - waifu.im only"
        echo "  nekosapi   - nekosapi.com v4 only"
        echo "  nekos.best - nekos.best only"
        echo "  danbooru   - Danbooru only (JSON API) - supports femboy, trap, and more"
        exit 0
    fi

    # ============================================================
    # Parse positional displayer from first arg
    # ============================================================
    DISPLAYER="$DEFAULT_DISPLAYER"
    if [[ $# -ge 1 ]]; then
        case "${1}" in
            icat|chafa|img2txt|jp2a)
                DISPLAYER="${1}"
                shift
                ;;
        esac
    fi

    # ============================================================
    # Parse mode/category/rating
    # ============================================================
    MODE="sfw"
    RATING_LEVEL="$DEFAULT_SFW"
    CATEGORY="waifu"
    IS_DIRECT_RATING=0

    if [[ $# -ge 1 ]]; then
        case "${1}" in
            sfw)
                MODE="sfw"
                RATING_LEVEL="$DEFAULT_SFW"
                [[ $# -ge 2 ]] && CATEGORY="$2"
                ;;
            nsfw)
                MODE="nsfw"
                RATING_LEVEL="explicit"
                [[ $# -ge 2 ]] && CATEGORY="$2"
                ;;
            safe|suggestive|borderline|explicit)
                RATING_LEVEL="${1}"
                IS_DIRECT_RATING=1
                [[ "${1}" == "explicit" ]] && MODE="nsfw" || MODE="sfw"
                [[ $# -ge 2 ]] && CATEGORY="$2"
                ;;
            *)
                CATEGORY="${1}"
                ;;
        esac
    fi

    # ============================================================
    # Unknown tag warning
    # ============================================================
    local TAG_UNKNOWN=1
    for t in "${ALL_KNOWN_TAGS[@]}"; do
        if [[ "$t" == "$CATEGORY" ]]; then
            TAG_UNKNOWN=0
            break
        fi
    done
    if [[ $TAG_UNKNOWN -eq 1 ]]; then
        for r in "${KNOWN_RATINGS[@]}"; do
            [[ "$r" == "$CATEGORY" ]] && { TAG_UNKNOWN=0; break; }
        done
    fi
    if [[ $TAG_UNKNOWN -eq 1 ]]; then
        echo "Warning: '$CATEGORY' not in known categories. See 'waifufetch --help'." >&2
    fi

    # ============================================================
    # Build API rating param
    # ============================================================
    build_api_rating

    # ============================================================
    # Debug output
    # ============================================================
    if [[ $DEBUG -eq 1 ]]; then
        echo "[debug] mode:         $MODE" >&2
        echo "[debug] rating_level: $RATING_LEVEL" >&2
        echo "[debug] is_direct:    $IS_DIRECT_RATING" >&2
        echo "[debug] api_rating:   $API_RATING" >&2
        echo "[debug] category:     $CATEGORY" >&2
        echo "[debug] default_sfw:  $DEFAULT_SFW" >&2
        echo "[debug] displayer:    ${DISPLAYER:-auto}" >&2
    fi

    local HAS_CONFIG=0

    # ============================================================
    # Dependency checks
    # ============================================================
    if [[ -f "$WAIFU_JSON_CONFIG" && ! -r "$WAIFU_JSON_CONFIG" ]]; then
        echo "Warning: Config file exists but is not readable: $WAIFU_JSON_CONFIG" >&2
    fi
    if [[ -f "$WAIFU_JSON_CONFIG" ]] && ! command -v jq &>/dev/null; then
        echo "Warning: 'jq' not found -- JSON config at $WAIFU_JSON_CONFIG will be ignored." >&2
        echo "Install jq with your package manager (e.g. pacman -S jq)." >&2
    fi

    # ============================================================
    # Main
    # ============================================================
    local tmpfile
    local image_url=""
    local offline_msg=""

    if [[ -n "$IMAGE_INPUT_FILE" ]]; then
        # Local file mode (-i <path>)
        if [[ ! -f "$IMAGE_INPUT_FILE" ]]; then
            echo "Error: File not found: $IMAGE_INPUT_FILE" >&2
            exit 1
        fi
        tmpfile="$(_mktemp)" && cp "$IMAGE_INPUT_FILE" "$tmpfile"
        image_url="file://$IMAGE_INPUT_FILE"
    else
        if ! command -v curl &>/dev/null; then
            echo "Warning: 'curl' not found -- cannot fetch waifu images." >&2
            echo "Install curl or use -i <file> for local images." >&2
            offline_msg="'curl' missing -- waifu image not available."
        elif ! curl --version &>/dev/null; then
            echo "Warning: curl is installed but broken (library link error?)." >&2
            echo "Try: pkg upgrade curl libngtcp2     (Termux)" >&2
            echo "  or: pacman -S curl                 (Arch)" >&2
            echo "  or: apt install --reinstall curl   (Debian)" >&2
            offline_msg="curl is broken -- waifu image not available."
            # Invalidate cache to prevent corrupted image display
            rm -f /tmp/waifu/meta.txt /tmp/waifu/img 2>/dev/null || true
        else
            fetch_and_cache
            if [[ -n "$IMAGE_URL" && -n "$IMAGE_FILE" && -s "$IMAGE_FILE" ]]; then
                tmpfile="$IMAGE_FILE"
                image_url="$IMAGE_URL"
            fi
        fi
    fi

    if [[ -z "$image_url" ]]; then
        # Detect offline condition
        if [[ -z "$offline_msg" ]] && command -v curl &>/dev/null; then
            local _ping_check
            _ping_check="$(curl -sf --max-time 2 https://ifconfig.me 2>/dev/null || true)"
            if [[ -z "$_ping_check" ]]; then
                offline_msg="No internet connection -- waifu image not available."
            fi
        fi

        # Show system info even when no image is available
        local found=0
        for t in "${ALL_KNOWN_TAGS[@]}"; do
            [[ "$t" == "$CATEGORY" ]] && { found=1; break; }
        done
        if [[ $found -eq 0 ]]; then
            echo "Error: '$CATEGORY' not found in known categories." >&2
            echo "Run 'waifufetch --help' to see available categories." >&2
        else
            if [[ -n "$offline_msg" ]]; then
                echo "$offline_msg" >&2
            elif [[ $DEBUG -eq 1 ]]; then
                echo "[debug] No images for '$CATEGORY' with rating '$API_RATING'" >&2
            fi
        fi
        collect_info
        render_info_lines "$HAS_CONFIG"
        for _line in "${INFO_LINES[@]}"; do
            printf '  %s\n' "$_line"
        done
        rm -f "${tmpfile:-}"
        return
    fi

    # Collect system info
    collect_info

    # Determine if we have a config module override
    [[ -n "$CONFIG_MODULES_OVERRIDE" ]] && HAS_CONFIG=1

    # Render info lines (sets INFO_LINES, INFO_LINES_PLAIN, INFO_LINE_COUNT)
    render_info_lines $HAS_CONFIG

    # Find widest plain info line for art sizing
    local max_info_width=0
    local _il
    for _il in "${INFO_LINES_PLAIN[@]}"; do
        local _len=${#_il}
        [[ $_len -gt $max_info_width ]] && max_info_width=$_len
    done

    # Try display
    if [[ -s "$tmpfile" ]]; then
        local width="${COLUMNS:-80}"
        if command -v tput &>/dev/null; then
            local tput_w
            local tput_w tput_rc
            tput_w="$(tput cols 2>/dev/null)" && tput_rc=$? || tput_rc=$?
            [[ $tput_rc -eq 0 && "$tput_w" -gt 0 ]] && width="$tput_w"
        fi

        # Check if requested displayer is available
        local DISPLAYER_AVAILABLE=1
        if [[ -n "$DISPLAYER" ]]; then
            case "$DISPLAYER" in
                icat)
                    if [[ -z "${KITTY_WINDOW_ID:-}" && "${TERM:-}" != *kitty* ]] && ! command -v chafa &>/dev/null; then
                        echo "Error: '$DISPLAYER' requested but not available (kitty terminal or chafa required)." >&2
                        DISPLAYER_AVAILABLE=0
                    fi
                    ;;
                chafa)
                    if ! command -v chafa &>/dev/null; then
                        echo "Error: '$DISPLAYER' requested but not installed." >&2
                        echo "Install chafa (e.g., pacman -S chafa)" >&2
                        DISPLAYER_AVAILABLE=0
                    fi
                    ;;
                img2txt)
                    if ! command -v img2txt &>/dev/null; then
                        echo "Error: '$DISPLAYER' requested but not installed." >&2
                        echo "Install caca-utils (e.g., pacman -S caca-utils)" >&2
                        DISPLAYER_AVAILABLE=0
                    fi
                    ;;
                jp2a)
                    if ! command -v jp2a &>/dev/null; then
                        echo "Error: '$DISPLAYER' requested but not installed." >&2
                        echo "Install jp2a (e.g., pacman -S jp2a)" >&2
                        DISPLAYER_AVAILABLE=0
                    fi
                    ;;
            esac
        fi

        if [[ $DISPLAYER_AVAILABLE -eq 0 ]]; then
            # Displayer not available -- show system info without waifu
            local i
            for ((i=0; i<CONFIG_LOGO_PADDING_TOP; i++)); do echo; done
            for _line in "${INFO_LINES[@]}"; do
                printf '  %s\n' "$_line"
            done
            rm -f "${tmpfile:-}"
            return
        fi

        # icat for waifufetch uses text-art side-by-side (native icat
        # is meant for the standalone \`waifu\` command, not for fetch display)
        # Auto-detect displayer when none explicitly set
        if [[ -z "$DISPLAYER" ]]; then
            if command -v chafa &>/dev/null; then
                DISPLAYER="chafa"
            elif command -v img2txt &>/dev/null; then
                DISPLAYER="img2txt"
            elif command -v jp2a &>/dev/null; then
                DISPLAYER="jp2a"
            fi
        fi

        if [[ "$DISPLAYER" == "icat" ]]; then
            DISPLAYER=""
        fi

        # Warn about GIF with static-only displayers
        if is_gif_file "$tmpfile" 2>/dev/null; then
            if [[ "$DISPLAYER" == "jp2a" || "$DISPLAYER" == "img2txt" ]]; then
                echo "Warning: '$DISPLAYER' does not support GIF animation. Showing static frame only." >&2
                # Extract first frame as PNG for displayer compatibility
                local static_file
                static_file="$(_mktemp).png"
                if command -v convert &>/dev/null; then
                    convert "$tmpfile[0]" "$static_file" 2>/dev/null && tmpfile="$static_file"
                elif command -v ffmpeg &>/dev/null; then
                    ffmpeg -y -i "$tmpfile" -vframes 1 "$static_file" 2>/dev/null && tmpfile="$static_file"
                fi
            fi
        fi

        # Pre-compute info column position for the given displayer
        local WAIFU_INFO_COL=""
        if [[ "$DISPLAYER" == "chafa" ]]; then
            local _iw=$((width / 3 - 1))
            [[ $_iw -lt 8 ]] && _iw=8
            WAIFU_INFO_COL=$((_iw * 2 + 2))
        fi

        # ---- Logo padding top ----
        local i
        for ((i=0; i<CONFIG_LOGO_PADDING_TOP; i++)); do echo; done

        # ---- GIF animation (skipped when static displayer chosen) ----
        if is_gif_file "$tmpfile" \
            && [[ "$DISPLAYER" != "jp2a" && "$DISPLAYER" != "img2txt" ]]; then
            local frame_dir
            frame_dir="$(_mktemp_dir)"
            local frames_extracted=0
            if command -v convert &>/dev/null; then
                convert "$tmpfile" -coalesce "${frame_dir}/frame-%04d.png" 2>/dev/null && frames_extracted=1
            elif command -v ffmpeg &>/dev/null; then
                ffmpeg -i "$tmpfile" -vsync vfr "${frame_dir}/frame-%04d.png" 2>/dev/null && frames_extracted=1
            fi

            local frames=()
            [[ $frames_extracted -eq 1 ]] && frames=("$frame_dir"/*.png)
            local frame_count=${#frames[@]}

            if [[ $frame_count -gt 1 ]] && command -v chafa &>/dev/null; then
                # Smart GIF sizing: half terminal width, leave room for info
                local gif_w=$((width / 2 - 2))
                if [[ $max_info_width -gt 0 ]]; then
                    local available=$((width - max_info_width - 4))
                    [[ $available -lt $gif_w ]] && gif_w=$available
                fi
                [[ $gif_w -lt 15 ]] && gif_w=15
                [[ $gif_w -gt 100 ]] && gif_w=100
                local gif_h=$((gif_w * 2 / 3))
                # Match info line count, cap at terminal height
                local term_height="${LINES:-24}"
                if command -v tput &>/dev/null; then
                local _th _th_rc
                _th="$(tput lines 2>/dev/null)" && _th_rc=$? || _th_rc=$?
                [[ $_th_rc -eq 0 && "$_th" -gt 0 ]] && term_height="$_th"
            fi
                local height_cap=$((term_height - 3))
                [[ $INFO_LINE_COUNT -gt $gif_h ]] && gif_h=$INFO_LINE_COUNT
                [[ $gif_h -gt $height_cap ]] && gif_h=$height_cap
                [[ $gif_h -lt 5 ]] && gif_h=5

                # Use rendered info lines instead of re-building them
                local info_count=$INFO_LINE_COUNT
                local info_lines=("${INFO_LINES[@]}")

                # Pre-render all frames, pad to fill info text height
                local frame_art=()
                local frame_lines=$info_count
                local art_width=0
                for ((idx=0; idx<frame_count; idx++)); do
                    local out
                    out=$(chafa --format=symbols --symbols=block \
                        --size="${gif_w}x${gif_h}" \
                        "${frames[$idx]}" 2>/dev/null || true)
                    _readlines lines < <(printf '%s\n' "$out")
                    local nl=${#lines[@]}
                    # Pad with empty lines to match info_count
                    while (( nl < info_count )); do
                        lines+=("")
                        ((nl++))
                    done
                    frame_art+=("${lines[@]}")
                    if [[ $idx -eq 0 ]]; then
                        for line in "${lines[@]}"; do
                            local clean=$(printf '%s' "$line" | sed \$'s/\e\[[0-9;?]*[a-zA-Z]//g; s/[[:space:]]*$//')
                            local llen=${#clean}
                            [[ $llen -gt $art_width ]] && art_width=$llen
                        done
                    fi
                done
                [[ $art_width -lt 1 ]] && art_width=$gif_w

                local info_col=$((art_width + 2))
                local display_lines=$frame_lines

                # Frame delay (centiseconds)
                local frame_delay=5
                if command -v identify &>/dev/null; then
                    local raw
                    raw=$(identify -format "%T" "${frames[0]}" 2>/dev/null || echo "5")
                    [[ "$raw" =~ ^[0-9]+$ && "$raw" -gt 0 ]] && frame_delay="$raw"
                fi
                local sleep_sec
                if ((frame_delay < 10)); then
                    sleep_sec="0.0${frame_delay}"
                elif ((frame_delay < 100)); then
                    sleep_sec="0.${frame_delay}"
                else
                    local int_part=$((frame_delay / 100))
                    local frac_part=$((frame_delay % 100))
                    printf -v sleep_sec "%d.%02d" "$int_part" "$frac_part"
                fi

                # Print blank lines for animation area
                for ((i=0; i<display_lines; i++)); do echo; done
                # Print URL below
                [[ $NO_LINK -eq 0 ]] && echo "$image_url"

                # Move cursor back to top
                local url_line=$([[ $NO_LINK -eq 0 ]] && echo 1 || echo 0)
                local total_below=$((url_line))
                printf '\033[%dA' "$((display_lines + total_below))"

                local TT_SAVED
                TT_SAVED=$(stty -g 2>/dev/null || true)
                stty -echo -icanon 2>/dev/null || true
                printf '\033[?25l'

                local keep_going=true
                while $keep_going; do
                    for ((idx=0; idx<frame_count; idx++)); do
                        if read -t "$sleep_sec" -N 1 -s; then
                            keep_going=false
                            break
                        fi

                        # Print side-by-side: art | info
                        local art_start=$((idx * frame_lines))
                        for ((i=0; i<display_lines; i++)); do
                            local art="${frame_art[$((art_start + i))]:-}"
                            local info="${info_lines[$i]:-}"
                            if [[ -n "$art" && -n "$info" ]]; then
                                printf '%s\033[%dG%s\n' "$art" "$info_col" "$info"
                            elif [[ -n "$art" ]]; then
                                printf '%s\n' "$art"
                            elif [[ -n "$info" ]]; then
                                printf '\033[%dG%s\n' "$info_col" "$info"
                            else
                                echo
                            fi
                        done
                        # Print URL
                        [[ $NO_LINK -eq 0 ]] && echo "$image_url"

                        # Move cursor back to top for next frame
                        printf '\033[%dA' "$((display_lines + total_below))"
                    done
                done

                printf '\033[?25h'
                stty "$TT_SAVED" 2>/dev/null || true

                # Final static frame side-by-side
                for ((i=0; i<display_lines; i++)); do
                    local art="${frame_art[$i]:-}"
                    local info="${info_lines[$i]:-}"
                    if [[ -n "$art" && -n "$info" ]]; then
                        printf '%s\033[%dG%s\n' "$art" "$info_col" "$info"
                    elif [[ -n "$art" ]]; then
                        printf '%s\n' "$art"
                    elif [[ -n "$info" ]]; then
                        printf '\033[%dG%s\n' "$info_col" "$info"
                    else
                        echo
                    fi
                done
                [[ $NO_LINK -eq 0 ]] && echo "$image_url"
                # Cursor is at bottom of output -- prompt appears correctly
            else
                # Can't animate -- show static side-by-side with INFO_LINES
                _readlines art_lines < <(image_to_text "$tmpfile" "$width" "$INFO_LINE_COUNT" "$DISPLAYER" "$max_info_width" || true)
                if [[ ${#art_lines[@]} -gt 0 ]]; then
                    # Compute info column: chafa block chars are double-width
                    if [[ "$DISPLAYER" == "chafa" ]] && [[ -n "${DISPLAYER}" ]]; then
                        local _iw=$((width / 3 - 1))
                        [[ $_iw -lt 8 ]] && _iw=8
                        WAIFU_INFO_COL=$((_iw * 2 + 2))
                    fi

                    print_side_by_side_raw art_lines INFO_LINES 
                    [[ $NO_LINK -eq 0 ]] && echo "$image_url"
                else
                    echo ""
                    for _line in "${INFO_LINES[@]}"; do
                        printf '  %s\n' "$_line"
                    done
                fi
            fi
            rm -rf "$frame_dir" 2>/dev/null || true
        else
            # Static image: normal side-by-side ASCII art display
            _readlines art_lines < <(image_to_text "$tmpfile" "$width" "$INFO_LINE_COUNT" "$DISPLAYER" "$max_info_width" || true)

            if [[ ${#art_lines[@]} -gt 0 ]]; then
                print_side_by_side_raw art_lines INFO_LINES 
                [[ $NO_LINK -eq 0 ]] && echo "$image_url"
            else
                echo "  Waifu image unavailable (install chafa, img2txt, or jp2a)" >&2
                echo ""
                for _line in "${INFO_LINES[@]}"; do
                    printf '  %s\n' "$_line"
                done
            fi
        fi

        prefetch_cache
        rm -f "${tmpfile:-}"
    else
        for _line in "${INFO_LINES[@]}"; do
            printf '  %s\n' "$_line"
        done
    fi
    [[ $DEBUG -eq 1 ]] && echo "[debug] waifufetch: done" >&2
}

main "$@" || true
